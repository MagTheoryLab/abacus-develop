+template <typename TK, typename TR>
+std::vector<std::complex<double>> hamilt::DeltaSpin<hamilt::OperatorLCAO<TK, TR>>::fold_projectors(
+    const ModuleBase::Vector3<double>& kvec, int spatial, int projectors) const
+{
+    const int size = spatial * projectors;
+    std::vector<std::complex<double>> folded(size);
+    int offset = 0;
+    const int* orbital_start = this->ucell->get_iat2iwt();
+    for (int atom = 0; atom < this->ucell->nat; ++atom)
+    {
+        for (const auto& neighbor : this->B_I_data[atom])
+        {
+            const auto& r = neighbor.R_index;
+            const double angle = ModuleBase::TWO_PI * (kvec.x * r.x + kvec.y * r.y + kvec.z * r.z);
+            const std::complex<double> phase(std::cos(angle), std::sin(angle));
+            for (const auto& orbital : neighbor.nlm)
+            {
+                const int iw = orbital_start[neighbor.iat_adj] + orbital.first;
+                if (this->paraV->global2local_row(iw) >= 0 && this->paraV->global2local_col(iw) >= 0)
+                {
+                    const int first = iw / 2 * projectors + offset;
+                    for (int p = 0; p < orbital.second.size(); ++p)
+                    {
+                        folded[first + p] += phase * orbital.second[p];
+                    }
+                }
+            }
+        }
+        offset += this->B_I_nproj[atom];
+    }
+    Parallel_Reduce::reduce_all(folded.data(), size);
+    return folded;
+}
+
+template <typename TK, typename TR>
+std::vector<int> hamilt::DeltaSpin<hamilt::OperatorLCAO<TK, TR>>::omitted_projector_pairs() const
+{
+    static_assert(sizeof(double) == 2 * sizeof(int), "Probe packs real matrix values into two integers");
+    constexpr int orbitals = 27;
+    constexpr int projectors = 16;
+    const int* orbital_start = this->ucell->get_iat2iwt();
+    std::vector<double> coefficients;
+    std::vector<int> neighbors_before(this->ucell->nat + 1);
+    std::vector<int> kept;
+    for (int atom = 0; atom < this->ucell->nat; ++atom)
+    {
+        const auto& neighbors = this->B_I_data[atom];
+        neighbors_before[atom + 1] = neighbors_before[atom] + neighbors.size();
+        for (const auto& near : neighbors)
+        {
+            const size_t start = coefficients.size();
+            coefficients.resize(start + orbitals * projectors, 0.0);
+            for (const auto& orbital : near.nlm)
+            {
+                const int iw = orbital_start[near.iat_adj] + orbital.first;
+                if (this->paraV->global2local_row(iw) >= 0 && this->paraV->global2local_col(iw) >= 0)
+                {
+                    const size_t offset = start + orbital.first / 2 * projectors;
+                    std::copy(orbital.second.begin(), orbital.second.end(), coefficients.begin() + offset);
+                }
+            }
+        }
+        for (const auto& left : neighbors)
+        {
+            for (const auto& right : neighbors)
+            {
+                const auto r = right.R_index - left.R_index;
+                kept.push_back(this->pre_hr[atom]->find_matrix(left.iat_adj, right.iat_adj, r) != nullptr);
+            }
+        }
+    }
+    const int pair_count = kept.size();
+    const int coefficient_count = coefficients.size();
+    Parallel_Reduce::reduce_all(kept.data(), pair_count);
+    Parallel_Reduce::reduce_all(coefficients.data(), coefficient_count);
+    std::vector<int> result;
+    result.push_back(coefficient_count);
+    result.push_back(0);
+    int pair = 0;
+    for (int atom = 0; atom < this->ucell->nat; ++atom)
+    {
+        const auto& neighbors = this->B_I_data[atom];
+        for (int l = 0; l < neighbors.size(); ++l)
+        {
+            const auto& left = neighbors[l];
+            for (int j = 0; j < neighbors.size(); ++j)
+            {
+                const auto& right = neighbors[j];
+                if (kept[pair++] != 0)
+                {
+                    continue;
+                }
+                const auto r = right.R_index - left.R_index;
+                result.insert(result.end(), {atom, orbital_start[left.iat_adj] / 2, orbital_start[right.iat_adj] / 2,
+                                             neighbors_before[atom] + l, neighbors_before[atom] + j, r.x, r.y, r.z});
+                ++result[1];
+            }
+        }
+    }
+    const size_t start = result.size();
+    result.resize(start + 2 * coefficients.size());
+    std::memcpy(result.data() + start, coefficients.data(), coefficients.size() * sizeof(double));
+    return result;
 }

